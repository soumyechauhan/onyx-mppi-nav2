<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="turret" params="parent:=base_link">
    <!-- Turret base pedestal -->
    <link name="aiming_turret_support_link">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.10"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.10"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00034" ixy="0.0" ixz="0.0"
                 iyy="0.00034" iyz="0.0" izz="0.00018"/>
      </inertial>
    </link>

    <joint name="aiming_turret_support_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="aiming_turret_support_link"/>
      <origin xyz="0.72 0.13 0.27" rpy="0 0 0"/>
    </joint>

    <!-- Turret azimuth / pan link -->
    <link name="aiming_turret_link">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.10"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.10"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.75"/>
        <inertia ixx="0.0015" ixy="0.0" ixz="0.0"
                 iyy="0.0015" iyz="0.0" izz="0.0018"/>
      </inertial>
    </link>

    <!-- TODO(ankit): confirm real yaw limits with mech team before converting continuous to revolute -->
    <joint name="aiming_turret_joint" type="continuous">
      <parent link="aiming_turret_support_link"/>
      <child link="aiming_turret_link"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="5.0" velocity="1.5"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <!-- Turret elevation / tilt link -->
    <link name="aiming_tilt_link">
      <visual>
        <origin xyz="0 0 -0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.10 0.08 0.02"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.10 0.08 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="0.00009" ixy="0.0" ixz="0.0"
                 iyy="0.00013" iyz="0.0" izz="0.00004"/>
      </inertial>
    </link>

    <!-- TODO(ankit): verify pitch limits with mech team; +-90 deg risks self-collision with turret base -->
    <joint name="aiming_tilt_joint" type="revolute">
      <parent link="aiming_turret_link"/>
      <child link="aiming_tilt_link"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="1.0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <!-- Aiming camera mounted on tilt platform -->
    <xacro:camera_sensor name="aiming" parent="aiming_tilt_link" xyz="0 0 0.02" rpy="0 0 0"/>

    <!-- Target illumination / pointer laser -->
    <link name="aiming_laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.008" length="0.03"/>
        </geometry>
        <material name="laser_red"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.008" length="0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="aiming_laser_joint" type="fixed">
      <parent link="aiming_camera_link"/>
      <child link="aiming_laser_link"/>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
