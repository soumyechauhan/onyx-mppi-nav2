<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lidar" params="parent:=base_link">
    <!-- Forward lidar mount post -->
    <link name="lidar_mount">
      <visual>
        <geometry>
          <box size="0.20 0.055 0.035"/>
        </geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.20 0.055 0.035"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="lidar_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_mount"/>
      <origin xyz="0.65 0.0 0.00" rpy="0 0 0"/>
    </joint>

    <!-- 2D planar LiDAR link -->
    <link name="lidar_link">
      <visual>
        <geometry>
          <cylinder radius="0.045" length="0.07"/>
        </geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.045" length="0.07"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                 iyy="0.0002" iyz="0.0" izz="0.0003"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="lidar_mount"/>
      <child link="lidar_link"/>
      <origin xyz="0.08 0.0 0.055" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
