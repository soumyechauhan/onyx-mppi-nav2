<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="imu" params="parent:=base_link">
    <!-- IMU sensor frame placed near vehicle center of mass -->
    <link name="imu_link">
      <visual>
        <geometry>
          <box size="0.03 0.03 0.015"/>
        </geometry>
        <material name="lidar_black"/>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
                 iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="-0.015 -0.0031 0.1585" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
