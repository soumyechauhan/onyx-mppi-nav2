<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parameterized camera macro used for front, rear, and turret cameras -->
  <xacro:macro name="camera_sensor" params="name parent xyz rpy:='0 0 0'">
    <link name="${name}_camera_link">
      <visual>
        <geometry>
          <box size="0.06 0.05 0.04"/>
        </geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.06 0.05 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0000171" ixy="0.0" ixz="0.0"
                 iyy="0.0000217" iyz="0.0" izz="0.0000254"/>
      </inertial>
    </link>

    <joint name="${name}_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- REP-103 standard optical frame for vision / RViz / perception -->
    <link name="${name}_camera_optical_frame"/>

    <joint name="${name}_camera_optical_joint" type="fixed">
      <parent link="${name}_camera_link"/>
      <child link="${name}_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>
  </xacro:macro>

  <!-- Front and rear camera mounting towers -->
  <xacro:macro name="camera_mounts" params="parent:=base_link">
    <!-- Front camera mount tower (0.48 m tall) -->
    <link name="front_camera_mount_link">
      <visual>
        <origin xyz="0 0 0.24" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.48"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.24" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.48"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.24" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00578" ixy="0.0" ixz="0.0"
                 iyy="0.00578" iyz="0.0" izz="0.000045"/>
      </inertial>
    </link>

    <joint name="front_camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="front_camera_mount_link"/>
      <origin xyz="0.72 0.0 0.27" rpy="0 0 0"/>
    </joint>

    <!-- Rear camera mount tower (0.25 m tall, centered at z=0.125 to eliminate gap) -->
    <link name="rear_camera_mount_link">
      <visual>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.25"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.25"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00159" ixy="0.0" ixz="0.0"
                 iyy="0.00159" iyz="0.0" izz="0.000045"/>
      </inertial>
    </link>

    <joint name="rear_camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="rear_camera_mount_link"/>
      <origin xyz="-0.72 0.0 0.14" rpy="0 0 3.14159"/>
    </joint>
  </xacro:macro>

</robot>
