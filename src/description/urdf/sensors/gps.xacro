<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gps" params="parent:=front_camera_mount_link">
    <!-- GPS antenna mounting platform attached to front camera mast -->
    <link name="gps_platform_link">
      <visual>
        <geometry>
          <box size="0.14 0.10 0.01"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.14 0.10 0.01"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.000181" ixy="0.0" ixz="0.0"
                 iyy="0.000721" iyz="0.0" izz="0.0009"/>
      </inertial>
    </link>

    <joint name="gps_platform_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gps_platform_link"/>
      <origin xyz="-0.05 0.0 0.475" rpy="0 0 0"/>
    </joint>

    <!-- GNSS antenna puck receiver link -->
    <link name="gps_link">
      <visual>
        <geometry>
          <cylinder radius="0.035" length="0.03"/>
        </geometry>
        <material name="body_grey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.035" length="0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
                 iyy="0.00002" iyz="0.0" izz="0.00003"/>
      </inertial>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent link="gps_platform_link"/>
      <child link="gps_link"/>
      <origin xyz="-0.02 0.0 0.02" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
